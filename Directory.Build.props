<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <Authors>Lukasz Rozmej</Authors>
    <Copyright>Copyright (c) 2026 Lukasz Rozmej; Copyright (c) 2026 Xiangpeng Hao</Copyright>
    <RepositoryUrl>https://github.com/LukaszRozmej/BBTree</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/LukaszRozmej/BBTree</PackageProjectUrl>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <!-- The tag sets the version on release; local builds pack a preview. -->
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

</Project>
