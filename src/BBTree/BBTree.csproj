<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>BBTree</PackageId>
    <Description>Fast ordered maps for .NET on a B+-tree whose nodes search inline keys with SIMD: a map for one thread and a lock-free-read concurrent map. A C# port of the bbtree crate.</Description>
    <PackageTags>btree;b+tree;sorted;ordered;map;dictionary;concurrent;simd;collections</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BBTree.Tests" />
  </ItemGroup>

</Project>
